# Telegram Bot Token от @BotFather в Telegram
BOT_TOKEN=your_telegram_bot_token_here

# API ключ Google Gemini от Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Модель Gemini (по умолчанию gemini-2.5-flash)
# Также можно использовать gemini-2.0-flash, gemini-1.5-pro и др.
GEMINI_MODEL=gemini-2.5-flash
